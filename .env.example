# 镜像仓库同步平台 - 环境变量配置
# 使用方式: cp .env.example .env，然后修改下面的值
# 本文件由 docker compose / make up-compose 读取；make up（docker run）不会自动加载 .env。

# ===== 端口映射 =====
PORT=8080

# ===== 安全配置（生产环境务必修改）=====
# JWT 签名密钥: 随机长字符串，泄露后所有 token 可被伪造。
# 生成命令: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# 仓库密码加密主密钥: 设置后 registry 密码会 AES-GCM 加密存储。
# 不设置则明文存储（UI 会告警）。生成命令: openssl rand -hex 32
ENCRYPT_KEY=change-me-to-another-random-string

# ===== 默认管理员（仅首次启动 users 表为空时生效）=====
ADMIN_USERNAME=admin
# 首次登录后请立即修改默认密码。建议: 大小写+数字+特殊字符，≥8 位。
ADMIN_PASSWORD=Admin@ChangeMe

# ===== 其他 =====
TZ=Asia/Shanghai
